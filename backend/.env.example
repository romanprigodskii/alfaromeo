# Альфа-Ромео backend — copy to .env and adjust. All values have safe defaults; the Phase-0
# scaffold boots and answers GET /health even without Postgres/Redis running.

# Default 4000 to avoid the common :3000 collision. Override freely (§14).
PORT=4000

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://alfa:alfa@localhost:5432/alfa_romeo

# Redis — shared price cache (§11.4). Optional: without it, Pricing falls back to an in-memory cache.
REDIS_URL=redis://localhost:6379

# Anthropic — AI-orchestration (§11.7). The key stays on the backend ONLY: never logged, never
# returned to the client (which only ever calls /ai/*). Leave EMPTY to run the deterministic OFFLINE
# demo engine (SSE + drafts + guardrails all work without a key); set it for real Claude.
ANTHROPIC_API_KEY=
# Model "под задачу": fast for support/FAQ, stronger for coach/agent. Both optional (sensible default).
AI_MODEL=claude-sonnet-4-5
AI_MODEL_STRONG=claude-sonnet-4-5
# Max output tokens per turn.
AI_MAX_TOKENS=1024
# Guardrail: an agent action over this ₽ amount is shown as a draft but BLOCKED from execution.
AI_AGENT_MAX_AMOUNT_RUB=100000
# HMAC secret that signs action drafts (so confirm-action only runs drafts the AI genuinely issued).
# Empty → a random per-process secret (drafts won't verify across a restart / second instance).
AI_DRAFT_SECRET=
# How long a signed draft stays valid before confirm-action rejects it (seconds).
AI_DRAFT_TTL_SEC=600

# Pricing (§11.4) — live crypto prices via our backend.
# CoinGecko free demo works WITHOUT a key; a demo key just raises the rate limit (optional).
COINGECKO_API_KEY=
# USD→₽ — official Bank of Russia daily fixing JSON (no key, no scraping). Override only for testing.
CBR_URL=https://www.cbr-xml-daily.ru/daily_json.js
# How often to re-fetch the CBR fix (hours). CBR moves once per business day → 6–12h is plenty.
FX_REFRESH_HOURS=6
# How long the last CBR rate stays cached (seconds) so it survives a CBR outage + restart. 30 days.
FX_CACHE_TTL_SEC=2592000
# Emergency fallback USD→₽ rate — used ONLY if CBR and the cache are both unavailable.
FX_USD_RUB=92
# Assets the upstream stream tracks (comma-separated). Default covers the demo set.
PRICING_ASSETS=BTC,ETH,USDT,SOL,TON
# CoinGecko snapshot refresh cadence (seconds) — keeps 24h % fresh / covers WS gaps.
PRICING_SNAPSHOT_SEC=45
