{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alfa-romeo.bank/schema/acquiringPoint.schema.json",
  "title": "AcquiringPoint",
  "description": "An acquiring point (online / QR / terminal / crypto, §8.2, §11.3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "businessId", "type"],
  "properties": {
    "id": { "type": "string" },
    "businessId": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["online", "terminal", "qr", "link", "crypto"]
    },
    "label": { "type": ["string", "null"] }
  }
}
